        <mxCell id="drzQuR97J5blKJSc4rvd-47" parent="1" style="shape=note2;boundedLbl=1;whiteSpace=wrap;html=1;size=25;verticalAlign=top;align=left;fillColor=#1ba1e2;fontColor=#ffffff;strokeColor=#006EAF;labelBackgroundColor=none;" value="&lt;div align=&quot;left&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;un port &quot;carré en interface avec un module&quot;&amp;nbsp; est la marque d&#39;une inversion de dépendance&lt;/font&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;un module qui est en interface avec un port est un adaptateur: un élément qui transforme une interface de départ en interface de sortie&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;On doit protéger les module de logique métier des détails d&#39;implémentation de leurs dépendances techniques ou non ==&amp;gt; Architecture HEXAGONALE / Ports &amp;amp; Adapters&lt;/font&gt;&lt;/div&gt;" vertex="1">
